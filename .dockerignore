# Root-level .dockerignore — applies only to services whose docker-compose
# build context is the repo root: intake-service and eligibility-service
# (adr/0005-eligibility-agent-runtime-and-resilience.md), and records-service
# (Stage 3 — imports libs.patient_view_agent). Every other service still
# builds from its own directory with its own local .dockerignore, untouched.
.git/
.github/
frontend/
node_modules/
docs/
adr/
tests/
.claude/
.codex_tmp/
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.DS_Store

# Sibling services not needed in intake-service's/eligibility-service's/
# records-service's own build context (each still builds independently from
# its own directory).
services/gateway/
services/scheduling-service/
services/interop-service/
services/roi-service/

# db/ is mounted into the Postgres container at runtime (docker-compose.yml);
# it is not part of any Python service's build.
db/
