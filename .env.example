ENVIRONMENT=development

DB_HOST=postgres
DB_PORT=5432
DB_NAME=riverbend
DB_USER=riverbend_app
# Ships EMPTY, not "changeme". Review C2-TEMPLATE-CHANGEME-DB: removing
# docker-compose.yml's `${DB_PASSWORD:-changeme}` fallback accomplished less
# than it looked, because compose's failure message points a new operator at
# copying THIS file — so the documented setup path still booted Postgres on a
# predictable credential. The control was bypassed one file over.
#
# Generate a real value: `openssl rand -hex 32`. Compose now stops with a
# message naming this variable rather than starting a guessable database.
DB_PASSWORD=

# Admin/runtime role separation (P3, w8-planner-2 — closes AUD-B01: a table
# owner can always ALTER TABLE ... DISABLE TRIGGER on its own table, which
# let riverbend_app bypass audit_logs's append-only guard outright). The
# ADMIN account is now the Postgres bootstrap role and owns every schema
# object; riverbend_app connects as a non-owner runtime role instead — see
# db/migrations/028_admin_runtime_role_separation.sql and
# db/docker-init/00-create-app-role.sh.
#
# DB_ADMIN_PASSWORD is REQUIRED and must be a value DISTINCT from
# DB_PASSWORD (round 2 review) — sharing a secret between the two would let
# anyone who knows the runtime credential authenticate as the admin role
# too, defeating the whole privilege split. No `:-changeme` default and no
# fallback to DB_PASSWORD, same reasoning as that variable's own guard
# above: docker-compose.yml stops with a message naming this variable
# rather than starting a container on a guessable or shared credential, and
# db/docker-init/00-create-app-role.sh /
# db/migrations/scripts/create_admin_role.sql both independently refuse to
# run if the two values are equal. Generate a real value:
# `openssl rand -hex 32`.
DB_ADMIN_USER=riverbend_admin
DB_ADMIN_PASSWORD=

REDIS_URL=redis://redis:6379/0

PAYER_API_URL=https://edi.example.com/v1/eligibility
# Empty for the same reason as DB_PASSWORD above. The real key is issued by the
# clearinghouse; a placeholder that looks like a key invites someone to ship it.
PAYER_API_KEY=

# Review fix (round 1, 2026-08-05 — Stage 3 patient-view route): shared secret
# gateway sends as X-Internal-Token so records-service can tell a real
# gateway call apart from a direct caller hitting its published host port
# (docker-compose.yml) with a spoofed X-Actor-Id. Read by both gateway and
# records-service (services/*/config.py); GET /patients/{id}/view fails
# closed (denies everyone) while this is unset.
#
# Review round 2 (2026-08-05): deliberately shipped EMPTY here, not
# "changeme" — a valid-looking placeholder for a secret that gates real PHI
# access is itself a vulnerability (a deployment that never edits this file
# would otherwise ship a public, guessable value). records-service also
# rejects any configured value under 32 characters, so a short, hand-typed
# stand-in (e.g. literally "changeme") fails closed too, not just an empty
# one. Set the SAME real random value (e.g. `openssl rand -hex 32`) on both
# services in .env before this route will work at all.
#
# Review round 11 (2026-08-05): also read by intake-service now, gating
# POST /intake the same way — the gateway already requires a staff session
# before forwarding there, but intake-service itself had no way to tell that
# apart from a direct call to its own published host port, which let an
# unauthenticated caller use the duplicate-detection response as a
# patient/SSN-existence oracle. Same one shared value, all three services.
#
# Branch 7 (2026-08-15/20): now read by every domain service. 7A added
# eligibility-service and scheduling-service; 7B added interop-service and
# roi-service, which had verified no caller at all — so any process on the
# compose network could call them directly with a forged X-Actor-Id. That
# includes roi-service's GET /disclosures/{patient_id}, which releases a
# patient's records and has no gateway route at all. SEVEN services now share
# this one value (gateway forwards it; intake, records, eligibility,
# scheduling, interop and roi verify it), and the six verifiers refuse to
# START on an empty or under-32-character value rather than serve traffic that
# 401s every real request.
INTERNAL_SERVICE_TOKEN=

# Session policy. Both are client-approved (2026-08-13) and both matter on a
# shared clinical workstation.
#
# This template used to set 28800 (8h) here. Because docker-compose loads
# `.env`, that value OVERRODE the code default — so every environment built
# from this template kept an 8-hour idle window no matter what the code said,
# silently defeating the fix. Keep these two lines in step with
# services/gateway/config.py; tests/test_env_example_session_policy.py fails
# if they drift.
#
# Idle: refreshed on every authenticated request, so it only lapses an
# abandoned session. 15 minutes — long enough to work, short enough that an
# unattended machine is signed out before the next person sits down.
SESSION_TIMEOUT_SECONDS=900

# Absolute: never refreshed, so a session dies this long after sign-in however
# continuously it is used. 8h = one shift, forcing a fresh sign-in at handover.
ABSOLUTE_SESSION_TIMEOUT_SECONDS=28800

# eligibility-service resilience (Stage 1 — D4 / RIV-088 / RIV-141): bounded
# payer client, retry, circuit breaker, and Redis last-known-good cache.
ELIGIBILITY_PAYER_TIMEOUT_SECONDS=5
ELIGIBILITY_PAYER_MAX_RETRIES=2
ELIGIBILITY_BREAKER_FAILURE_THRESHOLD=5
ELIGIBILITY_BREAKER_RESET_SECONDS=30
ELIGIBILITY_CACHE_FRESH_TTL_SECONDS=300
ELIGIBILITY_CACHE_STALE_TTL_SECONDS=3600

# eligibility agent (Stage 2 — libs/eligibility_agent; wired into
# eligibility-service's /visits/{visit_id}/messages endpoint in Stage 3):
# which switchable AgentRuntime implementation the check_eligibility chat
# assistant uses. raw_bedrock is the default, no-framework runtime; langchain
# is a comparison spike (extra deps in libs/eligibility_agent/requirements-
# langchain.txt, never installed in CI); ollama (feature-readiness Stage 2)
# reuses the SAME raw_bedrock loop with a local-model adapter
# (libs/eligibility_agent/ollama_tool_port.py) in place of Bedrock — reads
# the same OLLAMA_BASE_URL/OLLAMA_MODEL vars as intake-service's Stage 1
# assistant below, no separate config surface. An unset/unrecognized value
# fails closed rather than silently picking a runtime — see
# libs/eligibility_agent/runtime.py::build_agent_runtime. No live Bedrock
# credential is set here — BEDROCK_MODEL_ID=changeme means the chat endpoint
# always degrades to a safe "assistant unavailable" reply in this repo (see
# adr/0005-eligibility-agent-runtime-and-resilience.md, "Unresolved").
ELIGIBILITY_AGENT_RUNTIME=raw_bedrock
# Already used by gateway/intake-service; the check_eligibility tool reuses
# the same var so it reaches eligibility-service's resilient (Stage 1)
# /eligibility endpoint the same way every other caller does.
ELIGIBILITY_URL=http://eligibility-service:8072
ELIGIBILITY_TOOL_TIMEOUT_SECONDS=5

# eligibility job queue (Stage 3 — D4/RIV-088/RIV-141 fix): async job
# lifecycle for the payer check, so /intake never blocks on it. See
# services/eligibility-service/jobs.py + worker.py and
# adr/0005-eligibility-agent-runtime-and-resilience.md.
ELIGIBILITY_JOB_MAX_RETRIES=3
ELIGIBILITY_JOB_MAX_MANUAL_RETRIES=1
ELIGIBILITY_JOB_STATUS_TTL_SECONDS=3600
ELIGIBILITY_JOB_LEASE_SECONDS=30
ELIGIBILITY_WORKER_POLL_INTERVAL_SECONDS=0.5
ELIGIBILITY_WORKER_RECLAIM_INTERVAL_SECONDS=15
# intake-service: bounds the ONE fast enqueue call to eligibility-service's
# job endpoint — never the payer round-trip itself.
ELIGIBILITY_JOB_ENQUEUE_TIMEOUT_SECONDS=3

# Metadata-only tracing (libs/tracing) — intake-service + eligibility-service
# only. Optional: unset, spans export to console (opentelemetry-sdk's
# ConsoleSpanExporter, no extra package). Set OTEL_EXPORTER_OTLP_ENDPOINT to
# ship to a real collector instead; a missing OTLP exporter package falls
# back to console rather than failing. Never captures payloads — see
# libs/tracing/spans.py and docs/planning/phi-safe-logging-policy.md.
OTEL_SERVICE_NAME=riverbend-service
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318

HL7_FEED_HOST=hl7.example.org
HL7_FEED_PORT=2575

# UNUSED — verified 2026-08-20. No code reads SESSION_SECRET: sessions are
# opaque random tokens (uuid4().hex) stored server-side in Redis under
# session:{token} and are never signed, so there is no signature for a secret
# to protect. Rotating this value has no effect on anything.
#
# Left in place rather than deleted so this note is discoverable, because the
# variable's mere presence implies a session-signing control that does not
# exist — the same trap as config/roles.yaml's unread `default_role`. If
# session signing is ever implemented, this becomes a real secret and must be
# set to a random value; until then it is documentation, not configuration.
SESSION_SECRET=

# LLM client (libs/llm_client) — provider-swappable, defaults to the
# no-network fake provider. Only set real credentials for a provider you
# actually intend to use.
#
# Stage 1 (feature-readiness) — intake-service's POST /intake/instructions
# (services/intake-service/instructions_wiring.py) reads these same
# provider/model vars; there is no separate provider-selection config surface
# for it. With the default LLM_PROVIDER=fake, that endpoint always returns
# its deterministic per-step template (see libs/intake_instructions/
# composer.py) — no network call is made. To exercise a live local model
# instead, set LLM_PROVIDER=ollama and OLLAMA_MODEL below, and make sure
# OLLAMA_BASE_URL actually reaches your Ollama server from wherever
# intake-service runs: `http://localhost:11434` only works when
# intake-service itself runs on the host (e.g. local `pytest` or a manual
# `uvicorn` run), not from inside its docker-compose container — a
# container-run intake-service needs a URL that resolves to the host machine
# (on Docker Desktop for macOS/Windows this is typically
# `http://host.docker.internal:11434`; on Linux, add
# `extra_hosts: ["host.docker.internal:host-gateway"]` to the service in
# docker-compose.yml, or point at the host's LAN/bridge IP directly).
#
# Codex review (2026-08-08, PR #24): this route deliberately does NOT use the
# shared LLM_TIMEOUT_SECONDS/LLM_MAX_RETRIES below — those default to 30s/3
# retries, which can exceed the gateway's own fixed 30s downstream timeout
# (services/gateway/app.py::_post) and return a 502 before this endpoint's
# safe template fallback ever reaches the browser. These two override just
# the timeout/retry budget for /intake/instructions; provider/model still
# come from LLM_PROVIDER/OLLAMA_* above.
#
# Codex review (2026-08-09, PR #24): both values are range-checked, not just
# parsed — an out-of-range value (timeout outside (0, 10] seconds, retries
# outside [0, 1]) degrades to the default the same way an unparseable value
# does (see services/intake-service/instructions_wiring.py), so a typo or an
# accidentally-too-large value can never reintroduce the "exceeds the
# gateway's 30s downstream timeout" failure this config exists to prevent.
INTAKE_INSTRUCTIONS_LLM_TIMEOUT_SECONDS=8
INTAKE_INSTRUCTIONS_LLM_MAX_RETRIES=0
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=changeme
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=changeme
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=changeme
# Bedrock credentials are NOT set here — boto3 reads them from the standard
# AWS credential chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# AWS_BEARER_TOKEN_BEDROCK, or a configured profile).
BEDROCK_MODEL_ID=changeme
AWS_REGION=us-east-1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS_PER_REQUEST=2000
LLM_MONTHLY_TOKEN_BUDGET=1000000

# Embedding client (libs/embedding_client) — provider-swappable, defaults to
# the no-network fake provider. No cloud embedding provider (OpenAI/
# Anthropic/Bedrock) is implemented by design; "ollama" is the local/offline
# option for anyone actually running the retrieval-eval corpus pipeline
# (libs/rag_corpus), so corpus/query text never leaves the environment.
EMBEDDING_PROVIDER=fake
OLLAMA_EMBED_MODEL=changeme
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MONTHLY_TOKEN_BUDGET=1000000

# RAG corpus builder (libs/rag_corpus) — config-driven size cap and cache
# location for the retrieval-eval harness's corpus. Built from db/seed's
# checked-in fixtures only, never a live DB or the client's raw export.
RAG_CORPUS_MAX_RECORDS=200
RAG_EMBEDDING_CACHE_DIR=.cache/rag_embeddings

# Retrieval store (libs/rag_corpus/vector_store.py) — "memory" (the
# pure-Python cosine ranker) is the no-infrastructure default and fallback;
# "pgvector" persists to the rag_embeddings table
# (db/migrations/010_pgvector_embeddings.sql, adr/0006) and requires the
# optional libs/rag_corpus/requirements.txt installed. Fails closed on an
# unrecognized value — see vector_store.py::build_vector_store.
RAG_VECTOR_STORE=memory

# Retrieval-eval harness (libs/rag_eval) — measurement only; see
# docs/planning/retrieval-eval-report-07-08-2026.md.
RAG_EVAL_TOP_K=1

# Policy corpus embeddings (libs/policy_corpus) — SEPARATE from
# EMBEDDING_PROVIDER above. The policy corpus (docs/RagDocs) is synthetic,
# non-PHI text, so it uses a real Bedrock embedding model directly via its
# own explicit model id — never inferred from BEDROCK_MODEL_ID (that
# identifies a chat model, not an embedding model), and never selectable
# through EMBEDDING_PROVIDER, which stays local-only by design for the
# patient-encounter corpus. Reuses AWS_REGION above. No live embedding
# credential is set here — POLICY_EMBEDDING_MODEL_ID=changeme means the
# policy corpus has no real embedding model configured by default.
POLICY_EMBEDDING_MODEL_ID=changeme
