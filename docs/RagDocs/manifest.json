{
  "schema_version": 1,
  "corpus_id": "riverbend-synthetic-training-policies-v1",
  "notice": "SYNTHETIC TRAINING CORPUS. No real patient data or client production policy. A document describes approved training behavior; it does not prove that the application implements that behavior.",
  "metadata_authority": "manifest",
  "ingestion": {
    "content_root": ".",
    "allowed_extensions": [".md"],
    "encoding": "utf-8",
    "max_document_bytes": 20000,
    "max_documents": 32,
    "chunking": {
      "strategy": "markdown_heading_sections",
      "max_characters": 1200,
      "overlap_characters": 120,
      "minimum_characters": 80,
      "preserve_heading_path": true
    },
    "required_chunk_metadata": [
      "corpus_id",
      "source_id",
      "source_version",
      "content_sha256",
      "section_id",
      "heading_path",
      "audiences",
      "workflows",
      "topics",
      "synthetic",
      "approval_status"
    ]
  },
  "retrieval_policy": {
    "filter_before_text_access": [
      "retrieval_enabled",
      "approval_status",
      "audiences",
      "workflows"
    ],
    "caller_fixed_fields": ["audiences", "workflows"],
    "model_may_only_narrow": ["topics"],
    "prohibited_model_controls": [
      "approval_status",
      "audiences",
      "workflows",
      "content_path",
      "patient_scope"
    ],
    "decision_authority": false,
    "patient_data_in_corpus": false
  },
  "optional_stores": {
    "vector": {
      "needed_now": true,
      "unit": "section_chunk",
      "stable_key": "source_id@source_version#section_id",
      "required_pre_filters": ["approval_status", "audiences", "workflows"],
      "note": "PostgreSQL/pgvector stores section embeddings; authorization and manifest filters remain mandatory and independent of vector similarity."
    },
    "graph": {
      "needed_now": false,
      "document_node_key": "source_id@source_version",
      "edge_source": "documents.relationships",
      "note": "The declared relationships are sufficient for a future graph projection; no graph database is required for this corpus size."
    }
  },
