// W10 Final Stage 7 (sub-slice 2) — Grafana Alloy log pipeline for the
// local observability POC. Discovers containers via the Docker socket,
// tails their stdout/stderr, and ships to Loki. Every backend service's
// logging_config.py emits the same plain-text format:
// "%(asctime)s %(levelname)s [<service>] %(message)s", with correlation
// ids interpolated into the message as "correlation_id=<id>" (see
// services/gateway/logging_config.py) — never structured JSON.
//
// OBS-M01 review fix: the Docker socket is host-wide — without filtering,
// this component would discover and tail EVERY container on the host, not
// just this project's, on a shared dev machine. The `keep` rule below
// scopes discovery to containers Compose itself labeled as belonging to
// THIS project (`com.docker.compose.project`, surfaced by discovery.docker
// as `__meta_docker_container_label_com_docker_compose_project`), compared
// against the resolved project name Compose passes into this container as
// COMPOSE_PROJECT_NAME (see docker-compose.yml's `alloy` service). This is
// a discovery-time filter, not a redaction step — application logging
// remains the PHI redaction boundary (see below).
//
// `service` is pulled out of the bracketed token and kept as a LABEL
// (bounded: one value per service, ~8 total). `correlation_id` is pulled
// out separately and attached as STRUCTURED METADATA, not a label — it is
// per-request and would blow up label cardinality if promoted to one; Loki
// still lets you search/filter on structured metadata directly.
//
// This pipeline does not do PHI redaction itself — that's
// libs/safe_logging's PHISafeFilter, already applied before a line is ever
// written to stdout (see logging_config.py). Alloy only parses what's
// already been written.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = env("COMPOSE_PROJECT_NAME")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.riverbend.receiver]
}

loki.process "riverbend" {
  // Non-greedy up to the first "[...]" rather than counting whitespace
  // tokens: Python's default asctime ("YYYY-MM-DD HH:MM:SS,mmm") itself
  // contains an embedded space, so "%(asctime)s %(levelname)s" is 3
  // whitespace-separated tokens, not 2 — matching up to the bracket avoids
  // depending on that count at all.
  stage.regex {
    expression = "^.*?\\[(?P<service>[^\\]]+)\\] (?P<msg>.*)$"
  }

  stage.labels {
    values = {
      service = "",
    }
  }

  stage.regex {
    expression = "correlation_id=(?P<correlation_id>\\S+)"
  }

  stage.structured_metadata {
    values = {
      correlation_id = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
