{
  "id": null,
  "uid": "ai-agent-observability",
  "title": "AI Agent Observability",
  "description": "W10 metrics Stage 2 — provider calls, tokens, latency, agent-run outcomes, citations, clinician review, and the eligibility circuit breaker, built on Stage 1's libs/metrics/ai.py series. Local POC, not production monitoring. No pending-review backlog panel: Stage 1 deliberately exposes no such gauge (a process-local one would reset on restart and lie; a truthful one needs a query per scrape, which the metrics module exists to avoid) — the backlog stays a database question, not a Prometheus one.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Provider call rate by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(bedrock_provider_calls_total[5m])) by (use_case, outcome)",
          "legendFormat": "{{use_case}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provider call latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.5, sum(rate(bedrock_call_duration_seconds_bucket[5m])) by (use_case, le))",
          "legendFormat": "{{use_case}} p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, sum(rate(bedrock_call_duration_seconds_bucket[5m])) by (use_case, le))",
          "legendFormat": "{{use_case}} p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provider tokens/s by model and use case",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "Absent, not zero, for a surface whose provider contract reports no usage (the eligibility assistant's Converse port discards the usage block) — see libs/metrics/ai.py.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(bedrock_input_tokens_total[5m])) by (use_case, model)",
          "legendFormat": "{{use_case}} in ({{model}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(bedrock_output_tokens_total[5m])) by (use_case, model)",
          "legendFormat": "{{use_case}} out ({{model}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent runs by provenance (real / fixture / fallback)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "The eligibility assistant has no real/fixture/fallback distinction of its own and reports provenance_label=\"not_applicable\" rather than borrowing one — see libs/metrics/ai.py::record_agent_run.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(agent_runs_total[5m])) by (use_case, provenance_label)",
          "legendFormat": "{{use_case}} / {{provenance_label}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Agent runs by termination reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(agent_runs_total[5m])) by (use_case, termination_reason)",
          "legendFormat": "{{use_case}} / {{termination_reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Average citations per completed answer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "Only a completed (\"answered\") run observes a citation count — a refusal deliberately carries none, so it never drags this toward zero. See libs/summary_agent/runtime.py and libs/policy_navigator/runtime.py.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(agent_citations_per_answer_sum[5m])) by (use_case) / sum(rate(agent_citations_per_answer_count[5m])) by (use_case)",
          "legendFormat": "{{use_case}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Clinician review outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(agent_review_outcomes_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Review wait time (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "Elapsed time from draft generation to clinician decision. No backlog panel: see dashboard description.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.5, sum(rate(agent_review_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, sum(rate(agent_review_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Eligibility circuit state",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "0 = closed (healthy), 1 = open (payer calls short-circuited to the last-known-good fallback). Process-local, matching the breaker itself.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green" },
                "1": { "text": "open", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "eligibility_circuit_open",
          "legendFormat": "circuit",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Eligibility circuit transitions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(eligibility_circuit_transitions_total[5m])) by (from_state, to_state)",
          "legendFormat": "{{from_state}} -> {{to_state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Categorical agent errors (records-service, eligibility-service)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "loki_ds" },
      "description": "Every line here logs only an error TYPE and, where present, correlation_id as Loki structured metadata — never a prompt, response, retrieved document, or raw provider error message. See libs/safe_logging and observability/alloy/config.alloy.",
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki_ds" },
          "expr": "{service=~\"records-service|eligibility-service\"} |~ `(?i)WARNING` |~ `(?i)(agent|navigator)`",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Estimated Bedrock cost by model and use case (W10 Metrics Stage 4)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "Cumulative bedrock_estimated_cost_usd_total — only ever incremented from an EXACT versioned rate match (libs/bedrock_pricing). A model with no configured rate contributes nothing here; see the rate-unavailable panel instead.",
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(increase(bedrock_estimated_cost_usd_total[1h])) by (model, use_case)",
          "legendFormat": "{{model}} / {{use_case}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Rate-unavailable usage events (W10 Metrics Stage 4)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "description": "bedrock_rate_unavailable_total — a real usage event with reported tokens but no exact versioned rate match for its model_id. Non-zero here means a deployed model has no price configured in libs/bedrock_pricing yet, not a cost of $0.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(bedrock_rate_unavailable_total[15m])) by (model, use_case)",
          "legendFormat": "{{model}} / {{use_case}}",
          "refId": "A"
        }
      ]
    }
  ]
}
